<?xml version="1.0" encoding="utf-8"?>
<!-- One TV, after the dashboard's header: model number small, the name given
     to the TV large, what is on screen, and the address. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Glasshouse.CardLabel" />

        <TextView
            android:id="@+id/pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textAppearance="@style/TextAppearance.Glasshouse.Pill" />
    </LinearLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Glasshouse.CardName" />

    <!-- What is on screen, while the TV is on. -->
    <LinearLayout
        android:id="@+id/showing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/fg80" />

        <TextView
            android:id="@+id/range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tag"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textAppearance="@style/TextAppearance.Glasshouse.Tag" />

        <TextView
            android:id="@+id/picture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/fg80" />
    </LinearLayout>

    <!-- The TV's Wake-on-LAN setting was off when last seen. -->
    <TextView
        android:id="@+id/wake_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:text="@string/tv_wake_off"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/fg60"
        android:visibility="gone" />

    <!-- Volume, while the TV is on: the remote's own steps, and mute. -->
    <LinearLayout
        android:id="@+id/volume_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/volume_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Glasshouse.CardLabel" />

        <ImageButton
            android:id="@+id/volume_down"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/square_button"
            android:contentDescription="@string/tv_volume_down"
            android:src="@drawable/ic_minus" />

        <ImageButton
            android:id="@+id/mute"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/square_button"
            android:contentDescription="@string/tv_mute"
            android:src="@drawable/ic_volume" />

        <ImageButton
            android:id="@+id/volume_up"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/square_button"
            android:contentDescription="@string/tv_volume_up"
            android:src="@drawable/ic_plus" />
    </LinearLayout>

    <!-- Power, and the dashboard: in every state, so neither needs hunting for. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/power"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            app:icon="@drawable/ic_power"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.4"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/tv_open" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/fg50" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tv_more_generic"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>
</LinearLayout>
