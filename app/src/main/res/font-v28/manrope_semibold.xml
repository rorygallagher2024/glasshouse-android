<?xml version="1.0" encoding="utf-8"?>
<!-- One weight of the variable Manrope the dashboard uses. Each weight is its
     own family because android:textFontWeight needs API 28. font/ has the
     static files for API 26-27, which ignore fontVariationSettings. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/manrope_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600"
        app:font="@font/manrope_variable"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 600"
        app:fontWeight="600" />
</font-family>
